<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="io.github.al3x1n0.keepassmobile.app_security">
    <!-- BiometricManager.canAuthenticate (hasStrongBiometrics). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Notifica del database aperto (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <!-- Azione "Blocca" della notifica del database aperto. -->
        <receiver
            android:name=".OpenNotificationReceiver"
            android:exported="false" />
    </application>
</manifest>
